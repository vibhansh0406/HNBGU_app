        <item name="colorPrimaryContainer">#E4F0E7</item>
        <item name="colorOnPrimaryContainer">#163D2E</item>
        <item name="android:windowBackground">@color/campusone_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
