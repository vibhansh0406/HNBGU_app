rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSameCollege(collegeId) {
      return isSignedIn() && userDoc().collegeId == collegeId;
    }

    function isSameSection(sectionKey) {
      return isSignedIn() && (
        userDoc().sectionKey == sectionKey ||
        (userDoc().role == 'TEACHER' && sectionKey in userDoc().assignedSectionKeys)
      );
    }

    function isCrOrTeacher() {
      return isSignedIn() &&
        (userDoc().role == 'CR' || userDoc().role == 'TEACHER') &&
        userDoc().verifiedRole == true;
    }

    function canPublishToSection(sectionKey) {
      return isSameSection(sectionKey) && isCrOrTeacher();
    }

    function isClubAdminFor(clubId) {
      return isSignedIn() && (
        isCrOrTeacher() ||
        (userDoc().role == 'CLUB_ADMIN' && clubId in userDoc().managedClubIds)
      );
    }

    // Anti-spam rate limit & payload validation helper
    function isValidPostSize(textField, maxLen) {
      return textField is string && textField.size() > 0 && textField.size() <= maxLen;
    }

    // 1. Colleges & Phase 3 Campus Life Collections (Per-College Isolated)
    match /colleges/{collegeId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Phase 3.1: Clubs (Moderation: public sees approved clubs; CR/Teacher approves new clubs & assigns Club Admins)
      match /clubs/{clubId} {
        allow read: if isSameCollege(collegeId) && (
          resource.data.isApproved == true || isClubAdminFor(clubId)
        );
        allow create: if isSameCollege(collegeId)
          && isValidPostSize(request.resource.data.name, 100)
          && (isCrOrTeacher() || request.resource.data.isApproved == false);
        allow update: if isSameCollege(collegeId) && isClubAdminFor(clubId);
        allow delete: if isSameCollege(collegeId) && isCrOrTeacher();
      }

      // Phase 3.1: Events Feed (3-State RSVP, Club Admin creation, CR/Teacher approval)
      match /events/{eventId} {
        allow read: if isSameCollege(collegeId) && (
          resource.data.isApproved == true || isClubAdminFor(resource.data.clubId)
        );
        allow create: if isSameCollege(collegeId)
          && isClubAdminFor(request.resource.data.clubId)
          && isValidPostSize(request.resource.data.title, 140)
          && (!('posterSizeBytes' in request.resource.data) || request.resource.data.posterSizeBytes <= 5242880);
        allow update: if isSameCollege(collegeId) && (
          isClubAdminFor(resource.data.clubId) ||
          // Students can update RSVP counters or report abuse
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['goingCount', 'interestedCount', 'notGoingCount', 'reportCount', 'isFlagged', 'updatedAt'])
        );
        allow delete: if isSameCollege(collegeId) && isClubAdminFor(resource.data.clubId);
      }

      // Phase 3.2: Privacy-First Lost & Found Board (No public phone numbers; 30-day auto-archive; CR moderation)
      match /lost_found/{itemId} {
        allow read: if isSameCollege(collegeId) && (
          resource.data.isHidden == false || isCrOrTeacher() || resource.data.reporterUid == request.auth.uid
        );
        allow create: if isSameCollege(collegeId)
          && request.resource.data.reporterUid == request.auth.uid
          && isValidPostSize(request.resource.data.itemTitle, 120)
          && (!('photoSizeBytes' in request.resource.data) || request.resource.data.photoSizeBytes <= 2097152);
        allow update: if isSameCollege(collegeId) && (
          resource.data.reporterUid == request.auth.uid ||
          isCrOrTeacher() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'isFlagged'])
        );
        allow delete: if isSameCollege(collegeId) && (
          resource.data.reporterUid == request.auth.uid || isCrOrTeacher()
        );

        // Private Claim / Contact Requests: only the requester and the item's poster can read/write
        match /contact_requests/{reqId} {
          allow read: if isSameCollege(collegeId) && (
            resource.data.requesterUid == request.auth.uid ||
            resource.data.posterUid == request.auth.uid
          );
          allow create: if isSameCollege(collegeId)
            && request.resource.data.requesterUid == request.auth.uid
            && request.resource.data.status == 'PENDING'
            && isValidPostSize(request.resource.data.message, 300);
          allow update: if isSameCollege(collegeId)
            && resource.data.posterUid == request.auth.uid
            && request.resource.data.status in ['ACCEPTED', 'IGNORED'];
        }
      }

      // Phase 3.3: Campus Directory & Student Correction Suggestions
      match /directory/{entryId} {
        allow read: if isSameCollege(collegeId);
        allow write: if isSameCollege(collegeId) && isCrOrTeacher();
      }

      match /directory_suggestions/{suggestionId} {
        allow read: if isSameCollege(collegeId) && (
          isCrOrTeacher() || resource.data.suggesterUid == request.auth.uid
        );
        allow create: if isSameCollege(collegeId)
          && request.resource.data.suggesterUid == request.auth.uid
          && isValidPostSize(request.resource.data.proposedChange, 300);
        allow update, delete: if isSameCollege(collegeId) && isCrOrTeacher();
      }
    }

    // 2. Users & Personal Sync
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'STUDENT' || request.resource.data.verifiedRole == false);
      allow update: if isSignedIn() && request.auth.uid == uid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedRole'])
            || resource.data.verifiedRole == request.resource.data.verifiedRole);

      match /attendance/{subjectId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /personal_assignments/{assignmentId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /syllabus_progress/{subjectId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /gpa_semesters/{semesterNumber} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // 3. Section-Scoped Data (Phase 1 Core + Phase 2 Study)
    match /sections/{sectionKey} {
      match /meta/timetable {
        allow read: if isSameSection(sectionKey);
        allow write: if canPublishToSection(sectionKey);
      }

      match /notices/{noticeId} {
        allow read: if isSameSection(sectionKey);
        allow create, update: if canPublishToSection(sectionKey)
          && isValidPostSize(request.resource.data.title, 140);
        allow delete: if canPublishToSection(sectionKey);
      }

      match /resources/{resourceId} {
        allow read: if isSameSection(sectionKey) && (
          resource.data.isHidden == false || canPublishToSection(sectionKey)
        );
        allow create: if isSameSection(sectionKey)
          && request.resource.data.uploaderUid == request.auth.uid
          && request.resource.data.fileSizeBytes is int
          && request.resource.data.fileSizeBytes <= 10485760
          && request.resource.data.category in ['NOTES', 'PYQ', 'ASSIGNMENT', 'OTHER'];
        allow update: if isSameSection(sectionKey) && (
          canPublishToSection(sectionKey) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvoterUids', 'reportCount', 'isFlagged', 'updatedAt'])
        );
        allow delete: if canPublishToSection(sectionKey) || resource.data.uploaderUid == request.auth.uid;
      }

      match /shared_assignments/{assignmentId} {
        allow read: if isSameSection(sectionKey);
        allow create, update, delete: if canPublishToSection(sectionKey);
      }

      match /exams/{examId} {
        allow read: if isSameSection(sectionKey);
        allow create, update, delete: if canPublishToSection(sectionKey);
      }

      match /syllabus/{topicId} {
        allow read: if isSameSection(sectionKey);
        allow create, update, delete: if canPublishToSection(sectionKey);
      }
    }
  }
}
